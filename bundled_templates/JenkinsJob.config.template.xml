<?xml version='1.1' encoding='UTF-8'?>
<flow-definition plugin="workflow-job">
  <actions/>
  <description>Generated by CISetup Config GUI（パイプラインはジョブ内蔵）</description>
  <keepDependencies>false</keepDependencies>
  <properties/>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition" plugin="workflow-cps">
    <script>{{PIPELINE_SCRIPT}}</script>
    <!-- CISetup が生成・管理する内蔵 Pipeline。Console Output 本文をログへ回収するため
         currentBuild.rawBuild を使うので、Script Security sandbox の外で実行する。 -->
    <sandbox>false</sandbox>
  </definition>
  <triggers>
{{JOB_TRIGGERS}}
  </triggers>
  <disabled>false</disabled>
</flow-definition>
